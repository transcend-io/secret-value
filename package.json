{
  "author": "Transcend Inc.",
  "name": "@transcend-io/secret-value",
  "description": "Type-safe wrapper for secret values",
  "version": "1.2.3",
  "homepage": "https://github.com/transcend-io/secret-value",
  "repository": {
    "type": "git",
    "url": "https://github.com/transcend-io/secret-value.git"
  },
  "license": "MIT",
  "main": "build/index",
  "files": [
    "build/**/*",
    "package.json"
  ],
  "scripts": {
    "update:sdks": "yarn set version from sources && yarn dlx @yarnpkg/sdks base",
    "update:deps": "yarn upgrade-interactive && yarn update:sdks",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint src --ext .ts",
    "prepublish": "yarn build",
    "test": "yarn build && yarn node $(yarn bin _mocha) \"build/tests/*.test.js\""
  },
  "dependencies": {
    "@transcend-io/type-utils": "^1.1.2",
    "fp-ts": "^2.16.1",
    "io-ts": "^2.2.21"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "chai": "4.5.0",
    "depcheck": "1.4.7",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-jsdoc": "46.10.1",
    "mocha": "11.7.5",
    "prettier": "3.8.3",
    "typescript": "5.3.3"
  },
  "packageManager": "yarn@4.14.1",
  "resolutions": {
    "serialize-javascript@npm:^6.0.2": "7.0.5"
  }
}
